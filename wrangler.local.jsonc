{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diantuo-local",
  "main": "worker/local.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".local/app",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [{ "binding": "DB", "database_name": "diantuo-local", "database_id": "00000000-0000-4000-8000-000000000000", "migrations_dir": "db/migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "diantuo-private-media" }],
  "observability": { "enabled": true }
}
